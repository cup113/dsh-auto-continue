{
  "name": "dsh-auto-continue",
  "version": "0.1.0",
  "private": true,
  "description": "Host-only DSH plugin: when a model request is rejected by the provider (INVALID_REQUEST), resume the work with a bounded, backoff-spaced automatic continuation turn.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.mjs\"",
    "stats": "node scripts/continue-stats.mjs",
    "mock-gateway": "node scripts/mock-gateway.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  }
}
